# Copy to .env and enter newly issued credentials locally.
# Story retrieval is local; no OpenAI embedding key or quota is needed.
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
# Optional speech synthesis; leave all three blank for text-only responses.
ENABLE_TTS=false
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
# Optional stable session signing secret. If blank, sessions reset on restart.
FLASK_SECRET_KEY=
